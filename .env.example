# =============================================================================
# Scholar Dashboard — API environment variables
#
# Copy to `.env` in the repo root for local development. The API loads it via
# DotNetEnv (Env.TraversePath().Load()). In production set these as real
# environment variables on the API service.
#
# Email setup is documented in full at docs/EMAIL_PROVIDERS.md
# =============================================================================

# --- Core ---------------------------------------------------------------
DATABASE_URL=
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=

REDIS_URL=
RABBITMQ_URL=

# =============================================================================
# EMAIL
# =============================================================================

# --- Which provider to use -----------------------------------------------
# smtp | gmass | mailchimp | resend | emailjs | log
EMAIL_PROVIDER=smtp

EMAIL_FROM_ADDRESS=partnerships@bhfuturesfoundation.org
EMAIL_FROM_NAME=BH Futures Foundation
EMAIL_REPLY_TO=

# Retry a transient failure on the next configured provider.
EMAIL_ENABLE_FALLBACK=false
EMAIL_FALLBACK_ORDER=

# Redirect EVERY outbound email here instead of the real recipient.
# Set this on staging. Leave empty in production or nobody gets their mail.
EMAIL_SANDBOX_REDIRECT_TO=

# Pause between messages in a bulk send. Raise to ~1500 on free tiers.
EMAIL_SEND_DELAY_MS=0

# Largest audience a single campaign may reach.
EMAIL_MAX_RECIPIENTS_PER_CAMPAIGN=500

# --- SMTP (free) ----------------------------------------------------------
# Gmail needs an App Password, not your account password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BH Futures Foundation

# --- GMass (free tier + paid) ---------------------------------------------
# API key from the GMass dashboard → Settings → API Keys.
# The SMTP username is the literal string "gmass" — that is not a placeholder.
GMASS_API_KEY=
GMASS_FROM_EMAIL=
GMASS_FROM_NAME=
# Defaults below are correct for GMass; override only if instructed.
# GMASS_SMTP_HOST=smtp.gmass.co
# GMASS_SMTP_PORT=587
# GMASS_SMTP_USERNAME=gmass

# --- Mailchimp Transactional / Mandrill (paid) ----------------------------
# This is the Transactional add-on, NOT Mailchimp Marketing.
# Key from https://mandrillapp.com/settings
# The from-domain must be verified or every send is silently rejected.
MAILCHIMP_TRANSACTIONAL_API_KEY=
MAILCHIMP_FROM_EMAIL=
MAILCHIMP_FROM_NAME=
MAILCHIMP_SUBACCOUNT=

# --- Resend (3k/month free, then paid) ------------------------------------
# Verify your domain at https://resend.com/domains before sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# --- EmailJS (200/month free) ---------------------------------------------
# EMAILJS_PRIVATE_KEY is REQUIRED for server-side sends, and you must enable
# "Allow EmailJS API for non-browser applications" in Account → Security.
# Your EmailJS template must use {{subject}} and {{{message_html}}} —
# three braces on message_html, or the HTML arrives escaped.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# =============================================================================
# SEEDED ACCOUNTS
# =============================================================================
# Password for the seeded partnerships@bhfuturesfoundation.org account.
# Only applied when the account is first created; ignored thereafter.
SEED_PARTNER_MEMBER_PASSWORD=Admin1234!

# =============================================================================
# SCHEDULED BACKUPS
# =============================================================================
# A database backup runs automatically on the days below. Driven by the backup
# history rather than an in-memory timer, so the schedule survives deploys and a
# container that was down on the scheduled day catches up when it returns.
#
# Scheduled backups NEVER include password hashes or session tokens — an
# unattended job should not produce credential-bearing files nobody is watching.
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_DAYS=1,15
BACKUP_SCHEDULE_HOUR_UTC=2
BACKUP_SCHEDULE_FORMAT=Json
BACKUP_RETENTION_DAYS=90

# =============================================================================
# NEWS SCRAPER
# =============================================================================
# Mirrors the three newest posts from bhfuturesfoundation.org/news into our own
# table once a day, so the dashboard widget reads our copy rather than depending
# on a third-party site being up during a page load.
#
# Same scheduling approach as backups above: "has a scrape happened today" is
# read from the stored FetchedAt column, not from an in-memory timer. A daily
# timer in a service that redeploys twice a day never fires at all.
#
# A failed scrape leaves the stored posts untouched. Stale news is information;
# an empty widget is a bug report.
NEWS_SCRAPE_ENABLED=true
NEWS_SCRAPE_HOUR_UTC=5

# =============================================================================
# EXTERNAL SIGN-IN (optional)
# =============================================================================
# Google and GitHub sign-in. Each provider is registered only when BOTH of its
# values are present, and the login screen shows a button only for providers the
# API reports as configured — so a half-configured provider is invisible rather
# than a button leading to an error page.
#
# Existing accounts only: signing in with a provider links to an account that
# already exists, matched on a verified email address. It never creates one.
# Accounts are created through scholar intake, with a role and a cohort.
#
# Google  → console.cloud.google.com → APIs & Services → Credentials
#           Authorised redirect URI:
#           https://<api-host>/api/auth/external/google/callback
# GitHub  → github.com/settings/developers → New OAuth App
#           Authorisation callback URL:
#           https://<api-host>/api/auth/external/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where the API sends the browser after external sign-in completes.
FRONTEND_BASE_URL=https://scholar-dashboard-frontend.vercel.app

# =============================================================================
# INTEGRATIONS
# =============================================================================

# ── Dropbox ──────────────────────────────────────────────────────────────────
# Receives the generated-password CSVs written during seeding.
#
# DO NOT use DROPBOX_ACCESS_TOKEN. Dropbox access tokens expire after ~4 hours,
# so a deployment configured with one stops working the same day. The app uses
# the OAuth2 offline flow instead: these three values never expire, and the API
# mints short-lived access tokens from them on demand and caches them.
#
# To obtain the refresh token, once:
#   1. Dropbox developer console → your app → Permissions: enable files.content.write
#      and files.content.read, then Submit.
#   2. Visit, in a browser (replace <APP_KEY>):
#      https://www.dropbox.com/oauth2/authorize?client_id=<APP_KEY>&response_type=code&token_access_type=offline
#   3. Approve, copy the authorisation code, then exchange it:
#      curl -u <APP_KEY>:<APP_SECRET> \
#        -d code=<CODE> -d grant_type=authorization_code \
#        https://api.dropboxapi.com/oauth2/token
#   4. Store the "refresh_token" from the response below.
#
# All three are optional. If any is missing, Dropbox uploads are skipped with a
# warning — the API still starts and serves normally.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

GOOGLE_SHEETS_CREDENTIALS=
